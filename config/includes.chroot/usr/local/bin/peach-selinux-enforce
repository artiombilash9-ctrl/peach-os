#!/bin/sh
# Peach OS -- passa SELinux dalla modalita' permissive a enforcing.
# Da usare su un sistema installato, dopo aver verificato i log con:
#   sudo ausearch -m AVC -ts recent
set -eu

if [ "$(id -u)" -ne 0 ]; then
	echo "Eseguire come root: sudo peach-selinux-enforce" >&2
	exit 1
fi

sed -i 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config
touch /.autorelabel
echo "SELINUX=enforcing impostato. Al prossimo avvio verra' eseguita la rietichettatura."
