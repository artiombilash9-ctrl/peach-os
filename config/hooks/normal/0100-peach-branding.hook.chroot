#!/bin/sh
# Peach OS -- locale, fuso orario, permessi e branding di sistema.
set -e

echo "P: Peach OS -- configurazione locale e branding"

# ---------------------------------------------------------------- lingua ---
sed -i 's/^# *it_IT.UTF-8 UTF-8/it_IT.UTF-8 UTF-8/' /etc/locale.gen
grep -q '^it_IT.UTF-8 UTF-8' /etc/locale.gen || echo 'it_IT.UTF-8 UTF-8' >> /etc/locale.gen
locale-gen
update-locale LANG=it_IT.UTF-8 LANGUAGE=it_IT:it LC_TIME=it_IT.UTF-8 2>/dev/null || true

# ------------------------------------------------------------ fuso orario ---
ln -sf /usr/share/zoneinfo/Europe/Rome /etc/localtime
echo "Europe/Rome" > /etc/timezone

# ---------------------------------------------------------------- sudo -----
chmod 0440 /etc/sudoers.d/peach
visudo -c > /dev/null

# ------------------------------------------------------------ permessi -----
chmod 0755 /usr/local/bin/peach-welcome /usr/local/bin/peach-session-setup \
	/usr/local/bin/peach-selinux-enforce /usr/local/bin/peach-firstboot \
	/usr/local/bin/peach-status
chmod 0755 /etc/skel/Desktop/peach-welcome.desktop
chmod 0644 /etc/xdg/autostart/peach-session-setup.desktop
chmod 0644 /usr/share/applications/peach-welcome.desktop
chmod 0644 /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/*.xml
chown -R root:root /etc/skel /etc/xdg/xfce4

# ---------------------------------------------------- cartelle in italiano ---
cat > /etc/xdg/user-dirs.defaults <<'EOF'
DESKTOP=Scrivania
DOWNLOAD=Scaricati
TEMPLATES=Modelli
PUBLIC=Pubblici
DOCUMENTS=Documenti
MUSIC=Musica
PICTURES=Immagini
VIDEOS=Video
EOF

# ------------------------------------------- machine-id rigenerato al boot ---
: > /etc/machine-id

# ------------------------------------------------------------ cache font ---
fc-cache -f > /dev/null 2>&1 || true
gtk-update-icon-cache -f -t /usr/share/icons/hicolor > /dev/null 2>&1 || true

echo "P: Peach OS -- branding completato"
exit 0
