#!/bin/sh
# Peach OS -- rinomina le voci del menu di avvio.
# Eseguito da live-build con working directory = binary/
set -e

for cfg in boot/grub/*.cfg isolinux/*.cfg; do
	[ -e "${cfg}" ] || continue
	sed -i \
		-e 's/Live system (amd64 fail-safe mode)/Peach OS 1.0 — Live (modalità compatibilità)/g' \
		-e 's/Live system (amd64)/Peach OS 1.0 — Live/g' \
		-e 's/Live system (autodetect) (fail-safe mode)/Peach OS 1.0 — Live (autodetect, compatibilità)/g' \
		-e 's/Live system (autodetect)/Peach OS 1.0 — Live (autodetect)/g' \
		-e 's/Live system, kernel/Peach OS 1.0 — Live, kernel/g' \
		-e 's/Utilities\.\.\./Strumenti.../g' \
		-e 's/Verify integrity of the boot medium/Verifica l'\''integrità del supporto/g' \
		-e 's/UEFI Firmware Settings/Impostazioni firmware UEFI/g' \
		"${cfg}"
done

# Avvio automatico: il menu non deve restare in attesa di un tasto.
# Il font di sistema del core GRUB contiene solo ASCII: carichiamo il nostro
# (nome univoco "Peach Sans Mono") per avere accenti e punteggiatura tipografica.
# Il modulo gettext + it.mo traducono i messaggi interni di GRUB (per esempio
# la riga del conto alla rovescia); le voci del menu sono gia' in italiano.
for cfg in boot/grub/grub.cfg isolinux/live.cfg; do
	[ -e "${cfg}" ] || continue
	if ! grep -q '^set timeout=' "${cfg}"; then
		{
			if [ "${cfg#boot/grub/}" != "${cfg}" ]; then
				# Con Secure Boot GRUB e' in lockdown e puo' rifiutare il
				# caricamento di moduli non firmati: in quel caso proseguiamo
				# senza traduzione invece di bloccare l'avvio.
				echo "if insmod gettext; then"
				echo "  set lang=it_IT"
				echo "else"
				echo "  clear"
				echo "fi"
				# Mouse GRUB: moduli USB/HID, solo su BIOS (su UEFI in
				# lockdown i moduli non firmati verrebbero rifiutati).
				echo 'if [ "${grub_platform}" = "pc" ]; then insmod usb; insmod usbms; insmod gfxmenu; insmod gfxterm_menu; fi'
			fi
			echo "loadfont /boot/grub/fonts/peach16.pf2"
			echo "set timeout=10"
			echo "set timeout_style=menu"
			cat "${cfg}"
		} > "${cfg}.new"
		mv "${cfg}.new" "${cfg}"
	fi
done

# Con Secure Boot GRUB e' in lockdown: rifiuta il modulo png (non firmato)
# e i comandi `terminal_output`/`play`. L'esecuzione di questi comandi
# interrompe lo script anche se racchiusi in un `if`. Su EFI (dove il
# terminale grafico e' gia' attivo) li saltiamo del tutto; restano attivi
# solo sul BIOS, dove non c'e' lockdown.
if [ -e boot/grub/config.cfg ]; then
	sed -E -i \
		-e 's|^insmod png$|if [ "${grub_platform}" = "pc" ]; then insmod png; fi|' \
		-e 's#^([[:space:]]*)insmod (efi_gop|efi_uga|video_bochs|video_cirrus|all_video|gfxterm)$#\1if [ "${grub_platform}" = "pc" ]; then insmod \2; fi#' \
		-e 's|^terminal_output gfxterm$|if [ "${grub_platform}" = "pc" ]; then terminal_output gfxterm; fi|' \
		-e 's|^play 960 440 1 0 4 440 1$|if [ "${grub_platform}" = "pc" ]; then play 960 440 1 0 4 440 1; fi|' \
		boot/grub/config.cfg
fi

# Persistenza: aggiungiamo una voce che riusa kernel e initrd della prima
# voce Live con il parametro "persistence" di live-boot.
CFG=boot/grub/grub.cfg
if [ -e "${CFG}" ] && ! grep -q 'persistenza' "${CFG}"; then
	LINUX=$(awk '/^[[:space:]]*linux[[:space:]]/ {print; exit}' "${CFG}")
	INITRD=$(awk '/^[[:space:]]*initrd[[:space:]]/ {print; exit}' "${CFG}")
	if [ -n "${LINUX}" ] && [ -n "${INITRD}" ]; then
		printf '\nmenuentry "Peach OS 1.0 — Live con persistenza" --hotkey=p {\n%s persistence\n%s\n}\n' \
			"${LINUX}" "${INITRD}" >> "${CFG}"
	fi
fi

exit 0
